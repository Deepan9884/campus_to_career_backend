PORT=5000
MONGODB_URI=
NODE_ENV=development

# ===== JWT Configuration =====
# IMPORTANT: Use strong secrets (minimum 32 characters with uppercase, lowercase, and numbers)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Client URLs =====
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:8081
FRONTEND_URL=http://localhost:5173
# For production on Vercel:
# CLIENT_URL=https://campus-to-career.vercel.app
# ADMIN_CLIENT_URL=https://campus-to-career-admin.vercel.app
# FRONTEND_URL=https://campus-to-career.vercel.app

# ===== Redis Configuration (for caching and token blacklist) =====
# Local: redis://localhost:6379
# Cloud Redis: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# ===== Field-Level PII Encryption =====
# CRITICAL: Generate a strong 32+ character key for AES-256-GCM encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used for encrypting sensitive user data (name, location, etc.)
ENCRYPTION_KEY=

# ===== OAuth Providers =====
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# ===== AI Configuration =====
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-1.5-flash
GEMINI_MODEL_FALLBACK=gemini-1.5-flash-8b
GEMINI_MAX_RPM=60
GEMINI_MAX_RPD=5000

# NVIDIA Nemotron Fallback Engine
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

# ===== Password Reset Configuration =====
RESET_TOKEN_SECRET=

# ===== Email Configuration =====
# SMTP (works locally, may be blocked on some cloud providers)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Email API Keys (HTTP-based, recommended for production/cloud)
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Brevo (formerly Sendinblue): https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Optional: For Resend testing (free tier only allows sending to your signup email)
RESEND_TEST_EMAIL=

# ===== Security & Monitoring =====
# These are optional but recommended for production

# Rate limiting (handled by Express rate-limit, no config needed)
# Account lockout (handled automatically with exponential backoff)
# Audit logging retention: 90 days (configured in AuditLog model)

# ===== Budget Limits (Optional - for AI cost tracking) =====
# AI_DAILY_BUDGET_USD=5.0
# AI_MONTHLY_BUDGET_USD=100.0

